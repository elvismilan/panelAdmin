{
    "name": "elvismilan/panel-admin",
    "description": "custom mvc panel admin with php8",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/"
        }
    },
    "authors": [
        {
            "name": "Elvis Milan"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "ext-pdo": "*",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^7.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0"
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse --no-progress --debug --memory-limit=512M",
        "test": "php tests/run.php",
        "test:reset-password": "php tests/reset_password_flow_smoke.php",
        "verify": [
            "@phpstan",
            "@test"
        ]
    }
}
