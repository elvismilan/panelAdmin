{
    "name": "elvismilan/panel-admin",
    "description": "custom mvc panel admin with php8",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:elvismilan/paneladmin-core.git"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-gd": "*",
        "ext-pdo": "*",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^7.0",
        "elvismilan/paneladmin-core": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "app/",
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Elvis Milan"
        }
    ],
    "config": {
        "preferred-install": {
            "elvismilan/paneladmin-core": "source",
            "*": "dist"
        },
        "sort-packages": true
    },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyse --no-progress --debug --memory-limit=512M",
        "test": "@php tests/run.php",
        "verify": [
            "@phpstan",
            "@test"
        ]
    }
}
