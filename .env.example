APP_DEBUG=false

SITE_ROOT='http://localhost/panelAdmin/public'
SITE_TITLE='Mi Panel'
LOGO='public/assets/media/logos/logo.png'

# Base de datos
# Opcion A: DSN completo (tiene precedencia si se define)
DB_NAME='mysql:host=localhost;dbname=admin_db'
# Opcion B: host y nombre por separado
# DB_HOST='localhost'
# DB_NAME='admin_db'
# DB_CHARSET='utf8mb4'
DB_USER='root'
DB_PASS=''
DB_PREFIX='wr_'

# Autenticacion
AUTH_ACTIVE_STATUS='H'
AUTH_LEGACY_ALGO='sha256'
AUTH_LEGACY_SALT=''

# Paginacion
PAGINATION_PER_PAGE=8

# Temas por area
PUBLIC_THEME_PACK='public'
PUBLIC_THEME_OPTION='1'
LOGIN_THEME_PACK='default'
LOGIN_THEME_OPTION='1'
# LOGIN_THEME_OPTION: 1=login-form-default
ADMIN_THEME_PACK='default'
ADMIN_THEME_OPTION='1'
# ADMIN_THEME_OPTION: 1=dashboard-default, 2=dashboard-compact

# Assets del tema
LOGIN_OPTION1_ASSET_BASE='/assets/theme-one'
LOGIN_OPTION2_ASSET_BASE='/assets/theme-two'
ADMIN_ASSET_BASE='/assets/theme-one'
LOGIN_ASSET_BASE='/assets/theme-one'

# Meta del panel admin
ADMIN_META_DESCRIPTION=''
ADMIN_META_KEYWORDS=''
ADMIN_META_AUTHOR=''

# Mail (PHPMailer - SMTP)
MAIL_HOST='mail.tudominio.com'
MAIL_PORT='587'
MAIL_ENCRYPTION='tls'
MAIL_USERNAME=''
MAIL_PASSWORD=''
MAIL_FROM_ADDRESS=''
MAIL_FROM_NAME='Mi Panel'

# Datos de contacto (usados en emails)
COUNTRY=''
ADDRESS=''
