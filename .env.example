APP_DEBUG=false

# Obligatorio desde paneladmin-core 1.0: URL completa (http/https) del sitio, sin barra
# final. Es la única fuente de URLs absolutas (canonical, sitemap, enlaces). Sin ella,
# todas las páginas responden "Sitio sin configurar" (HTTP 500).
APP_URL='https://tudominio.com'  # sin barra final; en local, la URL del vhost (https://web-revolution.dev:8890)
# Solo detrás de un proxy HTTPS que envíe X-Forwarded-Proto.
# TRUST_PROXY=false
SITE_TITLE='Mi Sitio'
LOGO='public/assets/media/logos/logo.png'

# ============================================================
# BASE DE DATOS
# ============================================================
#
# El sistema construye el DSN en este orden de precedencia:
#   1. DB_DSN  — si está definida, se usa tal cual (ignora DB_HOST/DB_NAME/DB_CHARSET)
#   2. DB_NAME — si no contiene ':', construye DSN con DB_HOST + DB_PORT + DB_CHARSET
# Usa UNA sola de las dos formas, para no configurar una copia de la base en un
# lado y leerla del otro.
#
# ---- OPCION A: Servidor compartido / cPanel / Plesk (lo más común) ----------
# Solo define host, nombre, usuario y contraseña. Puerto estándar 3306.
#
DB_HOST='localhost'
DB_NAME='usuario_nombrebd'
DB_USER='usuario_dbuser'
DB_PASS='contraseña_segura'
# DB_CHARSET='utf8mb4'   # opcional, utf8mb4 por defecto
#
# ---- OPCION B: Desarrollo local con MAMP (Mac) ------------------------------
# MAMP usa un socket Unix en lugar del puerto TCP estándar.
# Descomenta DB_DSN y borra DB_HOST y DB_NAME de la Opción A.
#
# DB_DSN='mysql:unix_socket=/Applications/MAMP/tmp/mysql/mysql.sock;dbname=admin_db;charset=utf8mb4'
# DB_USER='root'
# DB_PASS='root'
#
# ---- OPCION C: VPS / servidor dedicado con puerto personalizado --------------
# Usa DB_DSN si el puerto MySQL no es 3306.
#
# DB_DSN='mysql:host=127.0.0.1;port=3307;dbname=admin_db;charset=utf8mb4'
# DB_USER='dbuser'
# DB_PASS='contraseña_segura'
# ============================================================

# Autenticacion
AUTH_ACTIVE_STATUS='H'
AUTH_LEGACY_ALGO='sha256'
AUTH_LEGACY_SALT=''

# CSRF
# Tiempo de vida del token CSRF en segundos (minimo recomendado: 60)
CSRF_TOKEN_TTL_SECONDS=3600

# Session cookies (seguridad)
# SESSION_COOKIE_SECURE='auto'   # auto | true | false
# SESSION_COOKIE_SAMESITE='Lax'  # Lax | Strict | None
# SESSION_COOKIE_DOMAIN=''        # opcional

# Paginacion
PAGINATION_PER_PAGE=8

# Cache RBAC
# Intervalo en segundos para revalidar la version global del cache de permisos/menu.
RBAC_VERSION_CHECK_INTERVAL=30

# Admin: pantallas y plantillas en resources/themes/admin/ y app/Views/ del proyecto,
# con el theme en public/assets/theme-one. No hace falta ADMIN_*, LOGIN_* ni SITE_ROOT.

# Mail (PHPMailer - SMTP)
MAIL_HOST='mail.tudominio.com'
MAIL_PORT='587'
MAIL_ENCRYPTION='tls'
MAIL_USERNAME=''
MAIL_PASSWORD=''
MAIL_FROM_ADDRESS=''
# Por defecto, SITE_TITLE.
# MAIL_FROM_NAME=''

# Datos de contacto (usados en emails)
COUNTRY=''
ADDRESS=''

# Datos de contacto publicos (footer y paginas del sitio)
SITE_CONTACT_EMAIL=''
SITE_CONTACT_PHONE=''

# Contacto: email que recibe el aviso del formulario de Contacto
# (si esta vacio se usa MAIL_FROM_ADDRESS)
CONTACTO_NOTIFY_EMAIL=''

# Google Analytics 4 (sitio publico). ID de medicion con formato G-XXXXXXXXXX.
# Vacio = no se carga Analytics (recomendado en local para no ensuciar las metricas).
GA_MEASUREMENT_ID=''

# reCAPTCHA v2 checkbox (formulario de Contacto)
# Se activa cuando estan las dos keys; RECAPTCHA_ENABLED=false lo apaga.
# Sin keys, el formulario funciona igual pero sin verificacion anti-bot.
RECAPTCHA_SITE_KEY=''
RECAPTCHA_SECRET_KEY=''
