APP_DEBUG=false

APP_URL='https://tudominio.com/panel'
SITE_ROOT='http://tudominio.com'
SITE_TITLE='Mi Panel'
LOGO='public/assets/media/logos/logo.png'

# ============================================================
# BASE DE DATOS
# ============================================================
#
# El sistema construye el DSN en este orden de precedencia:
#   1. DB_DSN  — si está definida, se usa tal cual (ignora DB_HOST/DB_PORT)
#   2. DB_NAME — si no contiene ':', construye DSN con DB_HOST + DB_PORT + DB_CHARSET
#
# ---- OPCION A: Servidor compartido / cPanel / Plesk (lo más común) ----------
# Solo define host, nombre, usuario y contraseña. Puerto estándar 3306.
#
DB_HOST='localhost'
DB_NAME='usuario_nombrebd'
DB_USER='usuario_dbuser'
DB_PASS='contraseña_segura'
# DB_CHARSET='utf8mb4'   # opcional, utf8mb4 por defecto
#
# ---- OPCION B: Desarrollo local con MAMP (Mac) ------------------------------
# MAMP usa un socket Unix en lugar del puerto TCP estándar.
# Descomenta DB_DSN y comenta las variables de la Opción A.
#
# DB_DSN='mysql:unix_socket=/Applications/MAMP/tmp/mysql/mysql.sock;dbname=admin_db;charset=utf8mb4'
# DB_HOST='127.0.0.1'
# DB_NAME='admin_db'
# DB_USER='root'
# DB_PASS='root'
#
# ---- OPCION C: VPS / servidor dedicado con puerto personalizado --------------
# Usa DB_DSN si el puerto MySQL no es 3306.
#
# DB_DSN='mysql:host=127.0.0.1;port=3307;dbname=admin_db;charset=utf8mb4'
# DB_USER='dbuser'
# DB_PASS='contraseña_segura'
# ============================================================

# Autenticacion
AUTH_ACTIVE_STATUS='H'
AUTH_LEGACY_ALGO='sha256'
AUTH_LEGACY_SALT=''

# CSRF
# Tiempo de vida del token CSRF en segundos (minimo recomendado: 60)
CSRF_TOKEN_TTL_SECONDS=3600

# Session cookies (seguridad)
# SESSION_COOKIE_SECURE='auto'   # auto | true | false
# SESSION_COOKIE_SAMESITE='Lax'  # Lax | Strict | None
# SESSION_COOKIE_DOMAIN=''        # opcional

# Paginacion
PAGINATION_PER_PAGE=8

# Cache RBAC
# Intervalo en segundos para revalidar la version global del cache de permisos/menu.
RBAC_VERSION_CHECK_INTERVAL=30

# Temas por area
PUBLIC_THEME_PACK='public'
PUBLIC_THEME_OPTION='1'
LOGIN_THEME_PACK='default'
LOGIN_THEME_OPTION='1'
# LOGIN_THEME_OPTION: solo 1 (default)
ADMIN_THEME_PACK='default'
ADMIN_THEME_OPTION='1'
# ADMIN_THEME_OPTION: solo 1 (dashboard-default)

# Assets del tema
LOGIN_OPTION1_ASSET_BASE='/assets/theme-one'
ADMIN_ASSET_BASE='/assets/theme-one'
LOGIN_ASSET_BASE='/assets/theme-one'

# Meta del panel admin
ADMIN_META_DESCRIPTION=''
ADMIN_META_KEYWORDS=''
ADMIN_META_AUTHOR=''

# Mail (PHPMailer - SMTP)
MAIL_HOST='mail.tudominio.com'
MAIL_PORT='587'
MAIL_ENCRYPTION='tls'
MAIL_USERNAME=''
MAIL_PASSWORD=''
MAIL_FROM_ADDRESS=''
MAIL_FROM_NAME='Mi Panel'

# Datos de contacto (usados en emails)
COUNTRY=''
ADDRESS=''

# Testing (smoke test de reset de contraseña)
TEST_RESET_EMAIL=''
